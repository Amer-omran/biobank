# Model checkpoints / run artefacts
models/*
!models/README.md

# Secrets
.env
.env.*
!.env.example

# Frontend
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/coverage/
frontend/next-env.d.ts
frontend/*.tsbuildinfo
frontend/test-results/
frontend/playwright-report/
