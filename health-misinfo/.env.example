# Copy to .env and fill in. NEVER commit .env.
# --- Database (docker compose) ---
POSTGRES_DB=healthmisinfo
POSTGRES_USER=hmd
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# --- API (prefix HMD_) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
HMD_SECRET_KEY=
HMD_AUDIT_IP_SALT=
# Comma-separated list of allowed browser origins (no wildcards in production)
HMD_CORS_ORIGINS=http://localhost:3000
# Set true when served over HTTPS
HMD_COOKIE_SECURE=false
HMD_REVIEWS_REQUIRED=2
# Local development without Docker (SQLite fallback is used when unset):
# HMD_DATABASE_URL=postgresql+psycopg://hmd:password@localhost:5432/healthmisinfo
# HMD_ENVIRONMENT=development

# --- Build options ---
# 1 = include CPU torch/transformers in the API image so registered models can be served
INSTALL_ML=0
WEB_PORT=3000
